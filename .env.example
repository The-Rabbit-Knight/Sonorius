# ==============================================================================
# Sonorius - Environment Configuration Example
# ==============================================================================

# 1. URL of your OpenAI-compatible Kokoro TTS endpoint
# - Localhost (same machine): http://localhost:8880/v1/audio/speech
# - Remote / LAN server: MUST use https:// (plain http:// to non-localhost is blocked by default)
KOKORO_TTS_URL="http://localhost:8880/v1/audio/speech"

# 2. Optional: Path to a custom CA certificate bundle (.pem) if your remote
#    Kokoro HTTPS server uses a self-signed or private home-lab certificate.
# KOKORO_CA_BUNDLE="/path/to/your/rootCA.pem"

# 3. Advanced Override (Not Recommended): Set to "true" ONLY if your remote
#    Kokoro server runs over an already-encrypted tunnel (e.g., WireGuard/Tailscale)
#    and you understand that plain HTTP will be used on that interface.
# ALLOW_INSECURE_HTTP_TTS="false"

# 4. Optional: Custom TLS certificate & key for the Sonorius web UI (run_app.sh)
#    If omitted, ./run_app.sh generates a certificate in .certs/ when run with
#    --https or --lan (or in default mode if mkcert is installed; otherwise
#    default mode serves plain HTTP on localhost).
# SSL_CERT_FILE="/path/to/cert.pem"
# SSL_KEY_FILE="/path/to/key.pem"
